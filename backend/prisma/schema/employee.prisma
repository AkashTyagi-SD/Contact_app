model Employee {
    empid       Int      @id @default(autoincrement())
    firstname   String
    lastname    String
    birthofdate String
    photo       String
    joiningdate String
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt
    status      Status   @default(Active)
    is_deleted  Boolean  @default(false)
    User        User?    @relation(fields: [userId], references: [id])
    userId      String?

    @@index([userId])
}

enum Status {
    Active
    InActive
}
